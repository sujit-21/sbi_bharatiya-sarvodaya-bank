      "views": 45,
      "createdAt": "2026-06-02T19:04:07.331Z"
    },
    {
      "id": "kb-2",
      "title": "Understanding Fixed Deposit (FD) and Rates",
      "content": "Our Fixed Deposits offer competitive interest rates. Customers can open an FD with a minimum principal of $1,000. Interest is calculated using simple or compound interest and is automatically posted at maturity or on a quarterly schedule. Auto-renewal is supported.",
      "category": "Loans",
      "views": 32,
      "createdAt": "2026-06-02T19:04:07.331Z"
    },
    {
      "id": "kb-3",
      "title": "Merchant Payment Settlements & QR Codes",
      "content": "Merchants can generate static or dynamic QR codes from their dashboard. Customer payments are credited to the merchant account. Settlements are executed at EOD (End of Day) processing, transferring all pending receipts to the merchant primary balance.",
      "category": "Merchant Services",
      "views": 88,
      "createdAt": "2026-06-02T19:04:07.331Z"
    }
