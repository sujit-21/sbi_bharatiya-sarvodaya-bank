{
  "name": "ag10-banking",
  "version": "1.0.0",
  "description": "Enterprise Banking Ecosystem Simulator (3 Independent Portals with Tailwind CSS v4)",
  "main": "start-all.js",
  "scripts": {
    "start": "node start-all.js",
    "dev": "nodemon start-all.js",
    "start:all": "node start-all.js",
    "dev:all": "nodemon start-all.js",
    "hq:backend": "nodemon headquarter/backend/server.js",
    "hq:frontend": "nodemon headquarter/frontend/server.js",
    "branch:backend": "nodemon branches_and_employees/backend/server.js",
    "branch:frontend": "nodemon branches_and_employees/frontend/server.js",
    "customer:backend": "nodemon customers/backend/server.js",
    "customer:frontend": "nodemon customers/frontend/server.js",
    "clean-ports": "node kill-ports.js",
    "test": "node verify.js"
  },
  "nodemonConfig": {
    "watch": ["backend", "headquarter", "branches_and_employees", "customers", "frontend"],
    "ext": "js,jsx,html,css",
    "ignore": ["**/db.json", "**/backups/**", "**/*.json", "**/*.log", "node_modules/**"],
    "delay": 1500
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.0.0",
    "vite": "^5.2.0"
  }
}
